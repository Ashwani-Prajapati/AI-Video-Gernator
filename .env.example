# ====================================================================
# VividFlow AI Studio - Environment Variables Configuration Template
# ====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Video Generation Providers (Server-Side Secrets - Never committed)
# Google Video AI (Veo 2 / Gemini)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# OpenAI (Sora Video & GPT-4o Cinematic Storyboarding)
OPENAI_API_KEY=

# Runway ML (Gen-3 Alpha)
RUNWAYML_API_SECRET=

# Luma Dream Machine (Ray 2)
LUMA_API_KEY=

# Replicate (Wan 2.1 14B & Open Models)
REPLICATE_API_TOKEN=

# Self-Hosted Local ComfyUI (RTX GPU / AnimateDiff / Wan 2.1)
COMFYUI_ENDPOINT=http://127.0.0.1:8188

# Storage and Video Processing
FFMPEG_PATH=
TEMP_FILE_RETENTION_DAYS=7

# Optional Cloud Relational Database (Supabase / PostgreSQL)
# Defaults to embedded persistent ACID storage in data/vividflow_db.json if omitted
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
