# Backend API Base URL
# In local development, leave this empty to use the Vite proxy (http://localhost:5000).
# In production on Vercel, set this to your deployed backend URL:
# Example: VITE_API_URL=https://vividflow-backend.onrender.com
VITE_API_URL=
